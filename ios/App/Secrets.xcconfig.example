// Copy this file to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored — never commit actual keys.
//
// Both App and SportsNotWidget targets inherit these via
// $(SUPABASE_URL) / $(SUPABASE_ANON_KEY) build-setting refs.

SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY_HERE
